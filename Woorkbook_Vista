<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;600;700;800&display=swap" rel="stylesheet">
<style>*{box-sizing:border-box;margin:0;padding:0;}body{font-family:'Montserrat',sans-serif;font-size:12px;color:#0F1117;padding:30px 34px;line-height:1.6;}
h1{font-size:21px;font-weight:800;margin-bottom:3px;}h1 span{color:#534AB7;}
.sub{font-size:9px;font-weight:700;letter-spacing:0.18em;text-transform:uppercase;color:#8A8E9E;margin-bottom:22px;}
.sec{font-size:10px;font-weight:700;letter-spacing:0.15em;text-transform:uppercase;color:#534AB7;margin:18px 0 10px;padding-bottom:5px;border-bottom:1px solid #DDE1EA;}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:7px;margin-bottom:7px;}
.pf{background:#F4F6F9;border-left:3px solid #534AB7;border-radius:5px;padding:9px 12px;break-inside:avoid;}
.pfl{font-size:8px;font-weight:700;letter-spacing:0.15em;text-transform:uppercase;color:#534AB7;margin-bottom:4px;}
.pfv{font-size:11px;font-weight:300;color:#0F1117;white-space:pre-wrap;}
.et{grid-column:span 2;background:#EEEDFE;border-left-color:#6B61D4;}
table{width:100%;border-collapse:collapse;border:1px solid #DDE1EA;margin-bottom:7px;}
th{background:#141826;color:#8A8E9E;font-size:9px;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;padding:7px 10px;text-align:left;}
td{padding:7px 10px;font-size:11px;font-weight:300;color:#4A4E5C;border-bottom:1px solid #DDE1EA;}
tr:last-child td{border-bottom:none;}
.note{margin-top:22px;padding-top:10px;border-top:1px solid #DDE1EA;font-size:9px;color:#8A8E9E;text-align:center;}
@media print{*{-webkit-print-color-adjust:exact!important;print-color-adjust:exact!important;}body{padding:14px;}.pf{break-inside:avoid;}@page{margin:14mm 11mm;}}</style></head>
<body><h1>Workbook <span>AUTOCOM WAY</span></h1><div class="sub">Bootcamp · Resumen de compromisos</div>
<div class="sec">Reflexiones por sección</div>
<div class="grid">${fh}<div class="pf et"><div class="pfl">Etapa de cierre más complicada</div><div class="pfv">${rl}</div></div></div>
<div class="sec">Tabla SMA</div>
<table><thead><tr><th>Cliente</th><th>Etapa</th><th>Incertidumbre</th><th>Acción</th><th>Fecha</th><th>Status</th></tr></thead>
<tbody>${sr||'<tr><td colspan="6" style="text-align:center;color:#8A8E9E;font-style:italic;">Sin registros</td></tr>'}</tbody></table>
<div class="note">AUTOCOM WAY · Bootcamp · Usa Cmd+P / Ctrl+P para guardar como PDF</div></body></html>`;
  const blob=new Blob([html],{type:'text/html;charset=utf-8'});
  const url=URL.createObjectURL(blob);
  const a=document.createElement('a');a.href=url;a.target='_blank';a.rel='noopener';a.click();
  setTimeout(()=>URL.revokeObjectURL(url),5000);
  showToast('Documento abierto — usa Cmd+P / Ctrl+P para guardar PDF');
}

// Guardar manual con confirmación visual
function enviar(){
  showBadge('⏳ Guardando...');
  google.script.run
    .withSuccessHandler(r=>{
      if(r&&r.ok){showBadge('✓ Guardado en Sheets');showToast('✓ Respuestas guardadas correctamente');}
      else showToast('⚠️ Error al guardar');
    })
    .withFailureHandler(e=>showToast('⚠️ Error: '+String(e)))
    .guardar(collect());
}

function showToast(msg){const t=document.getElementById('toast');t.textContent=msg;t.classList.add('show');setTimeout(()=>t.classList.remove('show'),3200);}

// ══════════════════════════════════════════════
// INIT
// ══════════════════════════════════════════════
function init(){
  showBadge('⏳ Cargando...');
  google.script.run
    .withSuccessHandler(data=>{
      applyData(data);
      buildNav(); updProg();
      const sec=data&&data.found&&Number(data.seccion)>=1?Number(data.seccion):1;
      goTo(sec);
      showBadge(data&&data.found?'✓ Progreso restaurado':'✨ Bienvenido');
    })
    .withFailureHandler(()=>{
      buildNav(); updProg(); goTo(1);
      showBadge('✨ Workbook listo');
    })
    .cargar();
}
init();
</script>
</body>
</html>
