function collect(){
  const d={};
  FDS.forEach(id=>{const e=document.getElementById(id);d[id]=e?e.value:'';});
  d.s4_tabla=JSON.stringify(Array.from(document.querySelectorAll('#sma-body tr')).map(r=>Array.from(r.querySelectorAll('input')).map(i=>i.value)));
  d.s5_radio=rv;
  d.seccion=cur;
  d.completadas=[...done].join(',');
  return d;
}

function applyData(d){
  if(!d||!d.found) return;
  FDS.forEach(id=>{const e=document.getElementById(id);if(e&&d[id])e.value=d[id];});
  if(d.s4_tabla){try{const rows=JSON.parse(d.s4_tabla);if(rows&&rows.length){const tb=document.getElementById('sma-body');rows.forEach((rd,ri)=>{let tr=tb.querySelectorAll('tr')[ri];if(!tr){addRow();tr=tb.querySelectorAll('tr')[ri];}if(tr)Array.from(tr.querySelectorAll('input')).forEach((inp,ci)=>{if(rd[ci]!==undefined)inp.value=rd[ci];});});}}catch(e){}}
  if(d.s5_radio){rv=d.s5_radio;const m={activar:0,incertidumbre:1,formalizar:2};const i=m[d.s5_radio];if(i!==undefined){const os=document.querySelectorAll('.ro');if(os[i])os[i].classList.add('sel');}}
  if(d.completadas)d.completadas.split(',').forEach(n=>{if(n)done.add(Number(n));});
  if(d.seccion&&Number(d.seccion)>=1&&Number(d.seccion)<=9)cur=Number(d.seccion);
}

