      .guardar(collect());
  },2000);
}

document.addEventListener('input',()=>autoSave());
setInterval(()=>{if(!_saving){_saving=true;google.script.run.withSuccessHandler(()=>{_saving=false;}).withFailureHandler(()=>{_saving=false;}).guardar(collect());}},30000);

function showBadge(msg){const b=document.getElementById('save-badge');b.textContent=msg||'✓ Guardado';b.classList.add('show');setTimeout(()=>b.classList.remove('show'),2500);}

