];
let cur = 1, done = new Set(), rv = '';

function buildNav() {
  document.getElementById('snav').innerHTML = SECS.map(s=>`
    <div class="si${s.n===cur?' active':''}${done.has(s.n)?' done':''}" onclick="goTo(${s.n})">
      <div class="sin">${s.n}</div>
      <div><div class="sit">${s.t}</div><div class="sis">${s.s}</div></div>
      <div class="sic">✓</div>
