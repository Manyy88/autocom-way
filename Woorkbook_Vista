      <div><div class="sit">Resumen Final</div><div class="sis">Compromisos</div></div>
    </div>`;
}

function updProg() {
  const p = Math.round((done.size/9)*100);
  document.getElementById('progress-bar').style.width = p+'%';
  document.getElementById('p-big').textContent = p+'%';
  document.getElementById('p-sm').textContent = done.size+' de 9 secciones';
  document.getElementById('r-num').textContent = p+'%';
  document.getElementById('r-fill').style.strokeDashoffset = 113-(113*p/100);
}

function hasContent(n) {
  if(n===4) return true;
  const map={1:['s1_q1'],2:['s2_q1'],3:['s3_q1'],5:['s5_q1'],6:['s6_q1'],7:['s7_indicadores'],8:['s8_q1'],9:['c1']};
  return (map[n]||[]).some(id=>{const e=document.getElementById(id);return e&&e.value.trim();});
}

function goTo(n) {
  if(hasContent(cur)) done.add(cur);
  document.querySelectorAll('.sp-panel').forEach(p=>p.classList.remove('active'));
  document.getElementById('summary-panel').classList.remove('active');
  cur=n;
  const p=document.getElementById('s'+n);
  if(p){p.classList.add('active');window.scrollTo({top:0,behavior:'smooth'});}
  buildNav(); updProg(); lsSave();
}

function goToSummary() {
  if(hasContent(cur)) done.add(cur);
  document.querySelectorAll('.sp-panel').forEach(p=>p.classList.remove('active'));
  document.getElementById('summary-panel').classList.add('active');
  buildSummary(); cur=10; buildNav(); updProg(); lsSave();
